# FAOSTAT API-innlogging – KUN for importtjenesten (scripts/import).
#
# Kopiér denne fila til .env.local (som er git-ignorert) for lokal testing.
# I CI/produksjon settes disse som GitHub Actions Secrets – ALDRI i repoet.
# Lim ALDRI passordet inn i chat, commit eller PR.
#
# Uten disse hopper FAOSTAT-importen pent over, og seed-data brukes.

FAOSTAT_USERNAME=din-epost@example.com
FAOSTAT_PASSWORD=
